{
  "name": "el-zhady",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node --import tsx scripts/check-live-bundle.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b && node --import tsx scripts/check-content.ts",
    "test": "node --import tsx --test src/lib/*.test.ts supabase/tests/*.test.ts",
    "test:db": "node --import tsx supabase/tests/security.test.ts",
    "check:deploy": "node --import tsx scripts/check-deploy-config.ts",
    "test:live": "node --import tsx --test supabase/tests/live-quiz.test.ts",
    "test:live:browser": "node --import tsx scripts/testing/live-browser.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.8",
    "@fontsource/noto-serif": "^5.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
